generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  admin
}

enum TelegramPinStatus {
  none
  pending
  pinned
  error
}

enum TelegramPinSource {
  automatic
  manual
}

enum TelegramBanStatus {
  pending
  completed
  error
}

model User {
  id           String    @id @default(cuid())
  email        String    @unique
  username     String    @unique
  passwordHash String
  displayName  String?
  role         UserRole
  telegramId   String?   @unique
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
  sessions     Session[]

  @@map("users")
}

model Session {
  id          String   @id
  userId      String?
  user        User?    @relation(fields: [userId], references: [id], onDelete: Cascade)
  isBootstrap Boolean  @default(false)
  expiresAt   DateTime
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([userId])
  @@index([expiresAt])
  @@map("sessions")
}

model SystemSetting {
  id        String   @id @default(cuid())
  key       String   @unique
  value     String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("system_settings")
}

model Provider {
  id          String   @id @default(cuid())
  title       String
  urlTemplate String
  matchPrefix String?
  matchSuffix String?
  enabled     Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  streams     Stream[]

  @@index([enabled])
  @@index([title])
  @@map("providers")
}

model Stream {
  id             String          @id @default(cuid())
  title          String
  providerId     String?
  provider       Provider?       @relation(fields: [providerId], references: [id])
  streamKey      String?
  directUrl      String?
  userAgent      String?
  enabled        Boolean         @default(true)
  priority       Int             @default(0)
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt
  channelStreams ChannelStream[]

  @@index([providerId])
  @@index([enabled])
  @@index([title])
  @@map("streams")
}

model Channel {
  id                   String                @id @default(cuid())
  title                String
  description          String?
  enabled              Boolean               @default(true)
  defaultDelaySeconds  Int?
  defaultScale         String?
  createdAt            DateTime              @default(now())
  updatedAt            DateTime              @updatedAt
  playlistChannels     PlaylistChannel[]
  channelStreams       ChannelStream[]
  channelTimezones     ChannelTimezone[]
  frameState           ChannelFrameState?
  telegramPublications TelegramPublication[]

  @@index([enabled])
  @@index([title])
  @@map("channels")
}

model Playlist {
  id                String             @id @default(cuid())
  title             String
  enabled           Boolean            @default(true)
  priority          Int                @default(0)
  createdAt         DateTime           @default(now())
  updatedAt         DateTime           @updatedAt
  playlistChannels  PlaylistChannel[]
  playlistTimezones PlaylistTimezone[]

  @@index([enabled])
  @@index([title])
  @@map("playlists")
}

model PlaylistChannel {
  id         String   @id @default(cuid())
  playlistId String
  playlist   Playlist @relation(fields: [playlistId], references: [id], onDelete: Restrict)
  channelId  String
  channel    Channel  @relation(fields: [channelId], references: [id], onDelete: Restrict)
  enabled    Boolean  @default(true)
  priority   Int      @default(0)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([playlistId])
  @@index([channelId])
  @@index([enabled])
  @@map("playlist_channels")
}

model ChannelStream {
  id        String   @id @default(cuid())
  channelId String
  channel   Channel  @relation(fields: [channelId], references: [id], onDelete: Restrict)
  streamId  String
  stream    Stream   @relation(fields: [streamId], references: [id], onDelete: Restrict)
  enabled   Boolean  @default(true)
  priority  Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([channelId])
  @@index([streamId])
  @@index([enabled])
  @@map("channel_streams")
}

model TimezonePreset {
  id                String             @id @default(cuid())
  timezone          String
  label             String
  enabled           Boolean            @default(true)
  priority          Int                @default(0)
  createdAt         DateTime           @default(now())
  updatedAt         DateTime           @updatedAt
  channelTimezones  ChannelTimezone[]
  playlistTimezones PlaylistTimezone[]

  @@unique([timezone, label])
  @@index([enabled])
  @@index([timezone])
  @@index([label])
  @@map("timezone_presets")
}

model ChannelTimezone {
  id               String         @id @default(cuid())
  channelId        String
  channel          Channel        @relation(fields: [channelId], references: [id], onDelete: Restrict)
  timezonePresetId String
  timezonePreset   TimezonePreset @relation(fields: [timezonePresetId], references: [id], onDelete: Restrict)
  priority         Int            @default(0)

  @@index([channelId])
  @@index([timezonePresetId])
  @@map("channel_timezones")
}

model PlaylistTimezone {
  id               String         @id @default(cuid())
  playlistId       String
  playlist         Playlist       @relation(fields: [playlistId], references: [id], onDelete: Restrict)
  timezonePresetId String
  timezonePreset   TimezonePreset @relation(fields: [timezonePresetId], references: [id], onDelete: Restrict)
  priority         Int            @default(0)

  @@index([playlistId])
  @@index([timezonePresetId])
  @@map("playlist_timezones")
}

model TelegramChat {
  id        String   @id @default(cuid())
  title     String
  chatId    String
  enabled   Boolean  @default(true)
  isDefault Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([enabled])
  @@index([isDefault])
  @@index([title])
  @@map("telegram_chats")
}

model ChannelFrameState {
  id                String   @id @default(cuid())
  channelKey        String   @unique
  channelId         String?  @unique
  channel           Channel? @relation(fields: [channelId], references: [id], onDelete: SetNull)
  lastPublishedHash String
  lastPublishedAt   DateTime
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  @@index([lastPublishedAt])
  @@map("channel_frame_states")
}

model ForbiddenFrameReference {
  id            String   @id @default(cuid())
  label         String
  thumbnailHash String   @unique
  previewPath   String
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@index([label])
  @@map("forbidden_frame_references")
}

model TelegramPublication {
  id                      String             @id @default(cuid())
  channelKey              String
  channelId               String?
  channel                 Channel?           @relation(fields: [channelId], references: [id], onDelete: SetNull)
  chatId                  String
  messageId               Int
  frameHash               String
  channelTitle            String
  reactionCount           Int                @default(0)
  pinStatus               TelegramPinStatus  @default(none)
  pinSource               TelegramPinSource?
  pinError                String?
  pinnedAt                DateTime?
  discussionChatId        String?
  discussionRootMessageId Int?
  publishedAt             DateTime           @default(now())
  createdAt               DateTime           @default(now())
  updatedAt               DateTime           @updatedAt
  comments                TelegramComment[]
  bans                    TelegramUserBan[]

  @@unique([chatId, messageId])
  @@unique([discussionChatId, discussionRootMessageId])
  @@index([channelKey])
  @@index([channelId])
  @@index([pinStatus])
  @@index([publishedAt])
  @@map("telegram_publications")
}

model TelegramComment {
  id                String              @id @default(cuid())
  publicationId     String
  publication       TelegramPublication @relation(fields: [publicationId], references: [id], onDelete: Restrict)
  discussionChatId  String
  messageId         Int
  telegramUserId    String?
  authorUsername    String?
  authorDisplayName String
  text              String?
  hasMedia          Boolean             @default(false)
  telegramUrl       String
  messageCreatedAt  DateTime
  messageEditedAt   DateTime?
  createdAt         DateTime            @default(now())
  updatedAt         DateTime            @updatedAt
  ban               TelegramUserBan?

  @@unique([discussionChatId, messageId])
  @@index([publicationId])
  @@index([telegramUserId])
  @@index([messageCreatedAt])
  @@map("telegram_comments")
}

model TelegramUserBan {
  id                String              @id @default(cuid())
  commentId         String              @unique
  comment           TelegramComment     @relation(fields: [commentId], references: [id], onDelete: Restrict)
  publicationId     String
  publication       TelegramPublication @relation(fields: [publicationId], references: [id], onDelete: Restrict)
  discussionChatId  String
  telegramUserId    String
  authorUsername    String?
  authorDisplayName String
  note              String?
  status            TelegramBanStatus   @default(pending)
  errorMessage      String?
  bannedAt          DateTime?
  createdAt         DateTime            @default(now())
  updatedAt         DateTime            @updatedAt

  @@index([publicationId])
  @@index([telegramUserId])
  @@index([status])
  @@index([createdAt])
  @@map("telegram_user_bans")
}

model TelegramUpdateReceipt {
  updateId  Int      @id
  createdAt DateTime @default(now())

  @@index([createdAt])
  @@map("telegram_update_receipts")
}

model CaptionTemplate {
  id        String   @id @default(cuid())
  title     String
  template  String
  enabled   Boolean  @default(true)
  isDefault Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([enabled])
  @@index([isDefault])
  @@index([title])
  @@map("caption_templates")
}
